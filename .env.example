# Copy to .env locally. Keep secrets out of git, logs, and manifests.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
SECURITY_MODE=production
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GITHUB_TOKEN=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_PUBLISH_ACCESS_TOKEN=
X_PUBLISH_ACCESS_TOKEN_SECRET=
MARKET_CONTENT_PROVIDER=auto
AGENT_PLANNER_MODE=hybrid
AGENT_PLANNER_PROVIDER=auto
AGENT_PLANNER_MODEL=
MARKET_REQUIRE_CROSSCHECK=true
MARKET_SECONDARY_PROVIDER=massive
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_MARKET_INTERVAL=5m
MARKET_SOURCE_CONFLICT_THRESHOLD=0.02
MARKET_MAX_STALENESS_HOURS=120
MARKET_STOCK_SYMBOLS=NVDA,MSFT,AAPL
DRY_RUN=true
DAILY_MARKET_RUN_MODE=dry_run
GLOBAL_DELIVERY_KILL_SWITCH=true
DELIVER_ENABLED=false
AUTO_OPTIMIZATION_ENABLED=true
SELF_HEALING_ENABLED=true
PHOENIX_TRACING_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:4317
SOURCE_ROUTER_LIVE=true
RSS_FEEDS=https://finance.yahoo.com/news/rssindex,https://feeds.marketwatch.com/marketwatch/topstories/,https://www.federalreserve.gov/feeds/press_all.xml,https://blogs.nvidia.com/feed/,https://openai.com/news/rss.xml,https://www.cnbc.com/id/19854910/device/rss/rss.html,https://www.theverge.com/rss/ai-artificial-intelligence/index.xml
RSS_ITEMS_PER_FEED=8
JINA_ENRICH=true
OBSIDIAN_VAULT_PATH=
OBSIDIAN_CODEX_FOLDER=Codex
